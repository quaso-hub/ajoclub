# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Lihat di: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# --- Supabase ---
# Dapat dari: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# --- Admin Auth ---
ADMIN_AUTH_TOKEN=[RANDOM_TOKEN]
ADMIN_EMAIL=[EMAIL]

# --- WhatsApp ---
NUXT_PUBLIC_WHATSAPP_PHONE=6285188627365

# --- App ---
NUXT_PUBLIC_APP_NAME=AjoClub
