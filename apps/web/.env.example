# ============================================
# AjoClub Environment Variables
# Copy ke .env lalu isi nilai yang sesuai
# ============================================

# --- Database ---
# Development: SQLite (lokal)
# Production: PostgreSQL (Supabase atau Neon)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Supabase ---
# Dapat dari: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[ANON_KEY]
# Service role key: HANYA untuk server-side, JANGAN expose ke client
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]

# --- Admin Auth ---
# Token untuk development admin (ganti di production)
ADMIN_AUTH_TOKEN=[RANDOM_TOKEN]
# Email owner yang dapat role OWNER otomatis
ADMIN_EMAIL=[EMAIL_KAMU]

# --- WhatsApp ---
# Nomor WhatsApp (tanpa + atau 0 di depan)
NUXT_PUBLIC_WHATSAPP_PHONE=6285188627365

# --- App ---
NUXT_PUBLIC_APP_NAME=AjoClub

# --- Cloudflare (opsional, untuk analytics) ---
# CLOUDFLARE_ANALYTICS_TOKEN=[TOKEN]

# --- Production only ---
# NODE_ENV=production
