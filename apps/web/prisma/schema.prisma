generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seed: npx tsx prisma/seed.ts

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  project   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  supabaseId String?  @unique
  role       String   @default("VIEWER")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   @default("landing")
  status      String   @default("draft")
  domain      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioCategory {
  id          String              @id @default(cuid())
  slug        String              @unique
  label       String
  description String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PortfolioItem[]
  templates   PortfolioTemplate[]
}

model PortfolioTemplate {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  summary        String
  icon           String?
  categoryId     String?
  category       PortfolioCategory? @relation(fields: [categoryId], references: [id])
  tags           String             @default("[]")
  scenePreset    String             @default("cinematic-scroll")
  themeKey       String             @default("studio")
  accentColor    String             @default("#fb7185")
  motionIntensity String            @default("balanced")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          PortfolioItem[]
}

model PortfolioItem {
  id              String              @id @default(cuid())
  slug            String              @unique
  title           String
  summary         String
  problem         String?
  approach        String?
  result          String?
  credibility     String?
  status          String              @default("DRAFT")
  source          String              @default("INTERNAL_DEMO")
  consentStatus   String              @default("NOT_REQUIRED")
  tags            String              @default("[]")
  scenePreset     String              @default("cinematic-scroll")
  themeKey        String              @default("studio")
  accentColor     String              @default("#fb7185")
  mediaRefs       String              @default("[]")
  cameraShots     String              @default("[]")
  motionIntensity String              @default("balanced")
  featured        Boolean             @default(false)
  publishedAt     DateTime?
  archivedAt      DateTime?
  categoryId      String?
  templateId      String?
  category        PortfolioCategory?  @relation(fields: [categoryId], references: [id])
  template        PortfolioTemplate?  @relation(fields: [templateId], references: [id])
  sections        CaseStudySection[]
  metrics         CaseStudyMetric[]
  testimonials    Testimonial[]
  media           PortfolioMedia[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, publishedAt])
  @@index([featured])
}

model CaseStudySection {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioItem @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  title       String
  body        String
  kind        String        @default("narrative")
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CaseStudyMetric {
  id          String        @id @default(cuid())
  portfolioId String
  portfolio   PortfolioItem @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  label       String
  value       String
  note        String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Testimonial {
  id            String        @id @default(cuid())
  portfolioId   String?
  portfolio     PortfolioItem? @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  authorName    String
  authorRole    String?
  quote         String
  consentStatus String        @default("PENDING")
  source        String        @default("CLIENT_WORK")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MediaAsset {
  id          String           @id @default(cuid())
  storageKey  String           @unique
  url         String
  alt         String
  mimeType    String?
  width       Int?
  height      Int?
  source      String           @default("INTERNAL_DEMO")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  portfolios  PortfolioMedia[]
}

model PortfolioMedia {
  id          String        @id @default(cuid())
  portfolioId String
  mediaId     String
  role        String        @default("gallery")
  sortOrder   Int           @default(0)
  portfolio   PortfolioItem @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  media       MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, mediaId, role])
}
