# ============================================
# AjoClub .gitignore
# Yang masuk git: apps/web/ (source), docker/ (configs), README.md
# Sisanya: hidden
# ============================================

# Dependencies
node_modules/

# Build output
.nuxt
.output
dist

# Environment & secrets
.env
.env.*
!.env.example

# Database
*.db
*.db-journal

# Logs
*.log
build.log
npm-debug.log*

# Test artifacts
playwright-report/
test-results/

# IDE & tools
.codegraph/
.cursor/
.omo/
.playwright-mcp/
.idea/
.vscode-test
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# AI agent files (never commit)
AGENTS.md
KEWARASAN.MD
Konteks_Awal.md

# Planning & memory (never commit)
.local/

# Documentation (not core)
docs/

# Screenshots & reference images
*.png
*.jpg
*.jpeg
*.webp
!apps/web/public/**

# GitHub workflows (hide CI/CD)
.github/workflows/

# Docker overrides
docker-compose.override.yml
.docker/

# Misc
*.tgz
*.lcov
coverage/
.nyc_output/
.parcel-cache/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
